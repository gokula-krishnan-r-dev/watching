{
  "id": "ceiling_win",
  "description": "Hitting daily ceiling during a block raises quiz_due (tighter rule wins)",
  "policy": {
    "quizMode": "app_block",
    "dailyCeilingMinutes": 5,
    "defaultBlockMinutes": 30,
    "allowRetryDuringCooldown": true
  },
  "rule": {
    "appId": "yt",
    "packageOrBundleId": "com.google.android.youtube",
    "allowed": true,
    "blockMinutes": 30,
    "grantOnPassMinutes": 30,
    "cooldownMinutes": 15
  },
  "initial": {
    "phase": "idle",
    "dayKey": "2026-10-05",
    "blockDurationMinutes": 30,
    "minutesAccruedInBlock": 0,
    "cooldownMinutes": 15,
    "minutesUsedToday": 0
  },
  "steps": [
    { "op": "open_app", "nowMs": 0 },
    { "op": "tick", "nowMs": 300001, "isAppActive": true }
  ],
  "expect": {
    "phase": "quiz_due",
    "minutesUsedToday": 5
  }
}
