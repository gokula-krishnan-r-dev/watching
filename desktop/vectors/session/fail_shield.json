{
  "id": "fail_shield",
  "description": "Quiz fail → device-wide shield; non-emergency cannot launch",
  "policy": {
    "quizMode": "app_block",
    "defaultCooldownMinutes": 15,
    "allowRetryDuringCooldown": true
  },
  "rule": {
    "appId": "yt",
    "packageOrBundleId": "com.google.android.youtube",
    "allowed": true,
    "blockMinutes": 15,
    "grantOnPassMinutes": 15,
    "cooldownMinutes": 15
  },
  "initial": {
    "phase": "quiz_due",
    "dayKey": "2026-10-05",
    "activePackage": "com.google.android.youtube",
    "activeAppId": "yt",
    "blockDurationMinutes": 15,
    "minutesAccruedInBlock": 15,
    "cooldownMinutes": 15,
    "minutesUsedToday": 15
  },
  "steps": [
    { "op": "quiz_fail", "nowMs": 1000 }
  ],
  "expect": {
    "phase": "shielded",
    "canLaunchRule": false,
    "shieldedUntilMs": 901000
  }
}
