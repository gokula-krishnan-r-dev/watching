{
  "id": "interval_tick",
  "description": "device_interval: 15 minutes of active use → quiz_due",
  "policy": {
    "quizMode": "device_interval",
    "quizIntervalMinutes": 15,
    "defaultCooldownMinutes": 15,
    "allowRetryDuringCooldown": true
  },
  "rule": {
    "appId": "safari",
    "packageOrBundleId": "mac:com.apple.Safari",
    "allowed": true,
    "blockMinutes": 15,
    "grantOnPassMinutes": 15,
    "cooldownMinutes": 15
  },
  "initial": {
    "phase": "idle",
    "dayKey": "2026-10-05",
    "blockDurationMinutes": 15,
    "minutesAccruedInBlock": 0,
    "cooldownMinutes": 15,
    "minutesUsedToday": 0
  },
  "steps": [
    { "op": "start_interval", "nowMs": 0 },
    { "op": "tick", "nowMs": 900001, "isAppActive": true }
  ],
  "expect": {
    "phase": "quiz_due",
    "minutesUsedToday": 15,
    "blockDurationMinutes": 15
  }
}
