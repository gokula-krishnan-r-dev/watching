{
  "id": "cooldown_expiry",
  "description": "Shield expires → idle; approved apps launchable again",
  "policy": {
    "quizMode": "app_block",
    "defaultCooldownMinutes": 15
  },
  "rule": {
    "appId": "yt",
    "packageOrBundleId": "com.google.android.youtube",
    "allowed": true,
    "blockMinutes": 15,
    "grantOnPassMinutes": 15,
    "cooldownMinutes": 15
  },
  "initial": {
    "phase": "shielded",
    "dayKey": "2026-10-05",
    "deviceShieldedUntilElapsedMs": 10000,
    "cooldownMinutes": 15,
    "minutesUsedToday": 0,
    "blockDurationMinutes": 15,
    "minutesAccruedInBlock": 0
  },
  "steps": [
    { "op": "expire_shield", "nowMs": 10000 }
  ],
  "expect": {
    "phase": "idle",
    "canLaunchRule": true
  }
}
