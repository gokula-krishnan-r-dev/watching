<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the child Aqua session. Install to /Library/LaunchAgents/
  (or Contents/Library/LaunchAgents/ inside the .app for SMAppService).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meritscreen.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/MeritScreen/meritscreen-agent</string>
    <string>--launch-agent</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
