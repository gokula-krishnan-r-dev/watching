<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 skeleton for MeritScreen Windows installer (phase d3).
  Build (when WiX is installed):
    wix build MeritScreen.wxs -o MeritScreen.msi
  Code-sign the MSI in CI once the EV/OV cert secrets exist.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="MeritScreen"
    Manufacturer="MeritScreen"
    Version="0.1.0"
    UpgradeCode="B7C2E9A1-4F3D-4A8E-9C11-2D6E8F0A1B2C"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="MeritScreen" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Service install via custom action calling meritscreen-guardian --install-service
         is preferred over ServiceInstall when the binary owns SCM registration. -->
    <CustomAction
      Id="InstallGuardianService"
      FileRef="GuardianExe"
      ExeCommand="--install-service"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="UninstallGuardianService"
      FileRef="GuardianExe"
      ExeCommand="--uninstall-service"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallGuardianService" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UninstallGuardianService" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MeritScreen" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="GuardianComp" Guid="A1111111-1111-1111-1111-111111111111">
        <File Id="GuardianExe" Source="meritscreen-guardian.exe" KeyPath="yes" />
      </Component>
      <Component Id="AgentComp" Guid="A2222222-2222-2222-2222-222222222222">
        <File Id="AgentExe" Source="meritscreen-agent.exe" KeyPath="yes" />
      </Component>
      <Component Id="UiComp" Guid="A3333333-3333-3333-3333-333333333333">
        <File Id="UiExe" Source="meritscreen-ui.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
