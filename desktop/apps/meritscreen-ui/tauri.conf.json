{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watching",
  "version": "0.1.0",
  "identifier": "com.meritscreen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Watching",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "tray_popover",
        "title": "Watching Menu",
        "url": "index.html?view=tray",
        "width": 380,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Watching",
      "tooltip": "Watching \u2014 Parent Sanctuary"
    },
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost https://tauri.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Watching",
    "category": "Education",
    "shortDescription": "Watching \u2014 parental controls, screen-time limits and learning quizzes",
    "longDescription": "Watching helps parents set screen-time limits, approve apps and turn screen time into learning time with adaptive quizzes for children. The desktop app includes the parent dashboard and the child guardian experience for macOS and Windows.",
    "copyright": "Copyright \u00a9 2026 Watching",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../../packaging/macos/entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
