<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Standard, Play-Store-compliant launcher exemption (no QUERY_ALL_PACKAGES
      declaration needed): apps that query for other launchable activities using this
      exact intent shape are visible to package-visibility filtering on API 30+.
      See https://developer.android.com/training/package-visibility.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
