# Local emulator secret for sendEmailOtp (gitignored).
# Copy to functions/.secret.local and fill in your key:
#
#   RESEND_API_KEY=re_xxxxxxxx
#
# Production: set via Firebase Secret Manager (never commit the key):
#   printf '%s' 're_xxxxxxxx' | firebase functions:secrets:set RESEND_API_KEY --data-file=-
#
# Production From address (verified Resend domain anajyo.com):
#   Default is MeritScreen <noreply@anajyo.com> via defineString RESEND_FROM_EMAIL.
#   Override only if the sending domain changes.
RESEND_API_KEY=
