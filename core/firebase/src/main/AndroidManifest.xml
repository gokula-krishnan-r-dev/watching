<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Data-only messages only (no `notification` payload sent server-side — see
          functions/src/index.ts) so onMessageReceived fires even while backgrounded. This
          service only fans the message out to Set<FcmMessageHandler> contributed by feature
          modules; see MeritScreenMessagingService.
        -->
        <service
            android:name=".messaging.MeritScreenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
